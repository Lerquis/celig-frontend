---
import Parragraph from "@/components/atoms/Parragraph.astro";
import Footer from "@/components/organisms/Footer.astro";
import Container from "../atoms/Container.astro";
import TitleServiceBlog from "../atoms/TitleServiceBlog.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath, type Locale } from "@/i18n";

interface Props {
  service: any;
  lang?: Locale;
}

const { service, lang: propLang } = Astro.props;
const lang = propLang || getLangFromUrl(Astro.url, Astro.request.headers.get("cookie"));
const t = useTranslations(lang);
---

<section class="pt-24 space-y-[50px] xl:space-y-[100px]">
  <Container>
    <TitleServiceBlog text={service.title} />
  </Container>

  <Container>
    {
      service.contenido
        .split("\n\n")
        .map((p: string) => (
          <Parragraph
            text={p}
            customClass="col-start-1 col-span-4 md:col-span-8 xl:col-span-12 xl:w-[70%] xl:mx-auto text-justify"
          />
        ))
    }

    {
      service.slug === "derechos-lgbtiq+" && (
        <div class="col-start-1 col-span-4 md:col-span-8 xl:col-span-12 xl:w-[70%] xl:mx-auto montreg tracking-[1px] text-[16px] !leading-[25px] text-justify">
          <p>
            {t("servicios.derechosTestimonialPre")}{" "}
            <a
              href={getLocalizedPath("/testimonios", lang)}
              class="cursor-pointer text-green-700 montbold"
            >
              {t("servicios.derechosTestimonialLink")}
            </a>{" "}
            {t("servicios.derechosTestimonialPost")}
          </p>
        </div>
      )
    }
  </Container>

  <Container>
    <p class="col-start-1 col-span-4 md:col-span-8 xl:col-span-12 xl:w-[70%] xl:mx-auto montlight tracking-[1px] text-[13px] leading-[20px] text-center text-black/50">
      {t("servicios.disclaimer")}{" "}
      <a href={getLocalizedPath("/politica-reembolsos", lang)} class="underline underline-offset-2 hover:text-black transition-colors duration-200">
        {t("servicios.disclaimerLink")}
      </a>.
    </p>
  </Container>

  <Footer lang={lang} />
</section>
