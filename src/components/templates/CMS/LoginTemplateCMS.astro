---
import { LoginForm } from "@/components/organisms/CMS/LoginFormCMS.jsx";
import TextCMS from "@/components/atoms/CMS/TextCMS.astro";
---

<div class="relative min-h-screen w-full flex items-center justify-center overflow-hidden">
  <img
    src="/HeroImage.jpeg"
    alt="CELIG"
    class="h-full w-full object-cover brightness-35 absolute inset-0 z-0 pointer-events-none"
  />
  <div
    class="bg-white relative z-10 p-6 md:p-8 rounded-lg shadow-2xl max-w-[420px] w-[90%] mx-auto flex flex-col gap-6"
  >
    <TextCMS
      customClass="text-2xl font-bold text-center text-black"
      content="Bienvenido/a al Sistema de Gestión de Contenido de CELIG"
    />
    <LoginForm client:load />
  </div>
</div>
