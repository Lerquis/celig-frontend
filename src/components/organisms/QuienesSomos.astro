---
import Container from "../atoms/Container.astro";
import Estadistica from "../atoms/Estadistica.astro";
import Parragraph from "../atoms/Parragraph.astro";
import SectionTitle from "../atoms/SectionTitle.astro";
import { getLangFromUrl, useTranslations, type Locale } from "@/i18n";

interface Props {
  lang?: Locale;
}

const { lang: propLang } = Astro.props;
const lang = propLang || getLangFromUrl(Astro.url, Astro.request.headers.get("cookie"));
const t = useTranslations(lang);
---

<section class="mt-[100px] mb-[200px] space-y-[100px] md:mt-[200px]">
  <Container
    fullWidth={false}
    customClass="space-y-[-50px] md:space-y-[-80px] title-animation"
  >
    <SectionTitle title={t("home.quienesSomos.title1")} customClass="col-start-1 col-span-4" />
    <SectionTitle
      title={t("home.quienesSomos.title2")}
      serif={true}
      customClass="col-start-2 col-span-3"
    />
  </Container>

  <Container fullWidth={false} customClass="space-y-[100px] md:space-y-[200px]">
    <Parragraph
      customClass="col-start-1 col-span-3 md:col-start-3 md:col-span-5 xl:col-start-6 xl:col-span-5 text-animation text-justify"
      text={t("home.quienesSomos.p1")}
    />

    <Parragraph
      customClass="col-start-2 col-span-3 text-right md:text-left md:col-start-1 md:col-span-5 xl:col-start-3 xl:col-span-5 text-animation text-justify"
      text={t("home.quienesSomos.p2")}
    />

    <Parragraph
      customClass="col-start-1 col-span-3 md:col-start-3 md:col-span-5 xl:col-start-6 xl:col-span-5 text-animation text-justify"
      text={t("home.quienesSomos.p3")}
    />

    <Parragraph
      customClass="col-start-2 col-span-3 text-right md:text-left md:col-start-1 md:col-span-5 xl:col-start-3 xl:col-span-5 text-animation text-justify"
      text={t("home.quienesSomos.p4")}
    />
  </Container>

  <Container fullWidth={false}>
    <div
      class="col-start-1 col-span-4 flex flex-col gap-[20px] md:col-span-8 md:gap-[50px] xl:col-span-12 xl:flex-row xl:justify-between xl:w-[80%] xl:mx-auto estadisticas"
    >
      <Estadistica
        title={t("home.quienesSomos.stat1Title")}
        value={t("home.quienesSomos.stat1Value")}
        customClass="self-end"
      />
      <Estadistica
        title={t("home.quienesSomos.stat2Title")}
        value={t("home.quienesSomos.stat2Value")}
        customClass="mx-auto"
      />
      <Estadistica title={t("home.quienesSomos.stat3Title")} value={t("home.quienesSomos.stat3Value")} customClass="self-start" />
    </div>
  </Container>

  <Container
    fullWidth={false}
    customClass="space-y-[-35px] text-right title-animation"
  >
    <SectionTitle
      title={t("home.quienesSomos.founderTitle1")}
      customClass="col-start-1 col-span-4 md:col-span-8 xl:col-span-12"
    />
    <SectionTitle
      title={t("home.quienesSomos.founderTitle2")}
      serif={true}
      customClass="col-start-1 col-span-4 md:col-span-8 !leading-[40px] xl:col-span-12"
    />
  </Container>

  <img
    src="/NewPP.jpg"
    alt="Ana Isabel Sibaja"
    width="100%"
    class="w-screen md:hidden"
  />

  <Container
    fullWidth={false}
    customClass="space-y-[50px] overflow-hidden relative"
  >
    <Parragraph
      customClass="col-start-1 col-span-3 md:col-span-5 text-animation text-justify"
      text={t("home.quienesSomos.founderP1")}
    />

    <Parragraph
      customClass="col-start-2 col-span-3 md:col-span-5 text-right xl:col-start-2 text-animation text-justify"
      text={t("home.quienesSomos.founderP2")}
    />

    <Parragraph
      customClass="col-start-1 col-span-3 md:col-span-5 xl:col-start-1 text-animation text-justify"
      text={t("home.quienesSomos.founderP3")}
    />

    <img
      src="/NewPP.jpg"
      alt="Ana Isabel Sibaja"
      width="100%"
      class="hidden md:flex md:h-[500px] xl:h-[100%] md:object-contain md:absolute md:right-0 md:w-[37%] xl:w-[49%]"
    />
  </Container>
</section>
