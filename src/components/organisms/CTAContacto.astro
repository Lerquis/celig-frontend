---
import Container from "../atoms/Container.astro";
import SectionTitle from "../atoms/SectionTitle.astro";
import Parragraph from "../atoms/Parragraph.astro";
import { getLangFromUrl, useTranslations, type Locale } from "@/i18n";

interface Props {
  lang?: Locale;
}

const { lang: propLang } = Astro.props;
const lang = propLang || getLangFromUrl(Astro.url, Astro.request.headers.get("cookie"));
const t = useTranslations(lang);

const defaultText = encodeURIComponent(t("whatsapp.defaultMessage"));
const whatsappUrl = `https://api.whatsapp.com/send/?phone=50683346441&text=${defaultText}&type=phone_number&app_absent=0`;
---

<section class="mb-[200px] space-y-[100px]">
  <Container
    fullWidth={false}
    customClass="space-y-[-50px] md:space-y-[-80px] title-animation"
  >
    <SectionTitle
      title={t("home.ctaContacto.title1")}
      customClass="col-start-1 col-span-4 md:col-span-8 text-center xl:col-span-12"
    />
    <SectionTitle
      title={t("home.ctaContacto.title2")}
      serif={true}
      customClass="col-start-1 col-span-4 md:col-span-8 text-center xl:col-span-12"
    />
  </Container>

  <Container fullWidth={false} customClass="space-y-[50px]">
    <Parragraph
      customClass="col-start-1 col-span-4 md:col-span-8 xl:col-span-12 text-animation text-center xl:w-[70%] xl:mx-auto"
      text={t("home.ctaContacto.p1")}
    />

    <Parragraph
      customClass="col-start-1 col-span-4 md:col-span-8 xl:col-span-12 text-center uppercase tracking-wide !font-bold"
      text={t("home.ctaContacto.p2")}
    />

    <div class="col-start-1 col-span-4 md:col-span-8 xl:col-span-12 flex justify-center">
      <a
        href={whatsappUrl}
        class="w-fit px-5 py-3 border border-black text-black montreg text-[11px] md:text-[13px] uppercase tracking-wide rounded-[4px] hover:bg-black hover:text-white transition-all duration-300"
      >
        {t("home.ctaContacto.button")}
      </a>
    </div>
  </Container>
</section>
