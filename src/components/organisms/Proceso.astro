---
import Container from "../atoms/Container.astro";
import SectionTitle from "../atoms/SectionTitle.astro";
import ProcesoItem from "../molecules/ProcesoItem.astro";

const processes = [
  {
    title: "Reservación de la fecha",
    parragraph: `El primer paso es seleccionar y reservar la fecha de tu matrimonio. Una vez confirmada la
    reservación, Ana Isabel comienza personalmente la preparación del proceso legal. Solo deben enviarnos
    los documentos de identificación de ambas personas contrayentes y de sus dos testigos, CELIG no proporciona
    testigos desconocidos a los contrayentes. Los testigos tienen una función jurídica real y deben cumplir con
    las condiciones exigidas por la legislación costarricense. Las parejas extranjerxs pueden usar pasaporte, 
    sin necesidad de partida de nacimiento, certificación de estado civil ni exámenes de sangre.`,
  },
  {
    title: "Grupo privado de WhatsApp",
    parragraph: `Al confirmar la reserva creamos un grupo privado de WhatsApp con la pareja: nuestro canal
    directo durante toda la preparación. Ahí coordinamos los borradores de las escrituras, revisamos
    nombres y datos, resolvemos dudas sobre el proceso legal y compartimos indicaciones importantes antes
    de la boda. La comunicación es directa con Ana Isabel en cada etapa.`,
  },
  {
    title: "Preparación de las escrituras",
    parragraph: `CELIG prepara previamente las escrituras y demás documentación necesaria para la
    celebración. Los borradores se envían a la pareja por el grupo privado de WhatsApp para su revisión
    antes de la boda, un procedimiento especialmente cómodo para las parejas extranjerxs, que pueden dejar
    todo listo antes de llegar a Costa Rica.`,
  },
  {
    title: "Coordinación de la boda y/o ceremonia",
    parragraph: `Cada pareja decide cómo vivir este momento: un matrimonio civil íntimo centrado en la
    formalización legal, o un matrimonio civil con ceremonia especial, emotiva y personalizada. Cuando se
    contrata una ceremonia, sus detalles también se coordinan por el grupo privado de WhatsApp, según lo
    que la pareja desee.`,
  },
  {
    title: "Celebración del matrimonio",
    parragraph: `El día reservado, la pareja se presenta junto a sus dos testigos. La Licda. Ana Isabel
    Sibaja realiza personalmente el matrimonio y dirige la firma de las escrituras. Todo fue preparado con
    anticipación para que ustedes solo tengan que disfrutar el momento. Llegan solteros y se van casadxs.`,
  },
  {
    title: "Inscripción del matrimonio",
    parragraph: `Después de la celebración y firma de las escrituras, gestionamos la inscripción legal del
    matrimonio en Costa Rica. La pareja recibe acompañamiento durante esta etapa y se mantiene en
    comunicación con CELIG.`,
  },
  {
    title: "Apostilla, traducción y envío internacional",
    parragraph: `Para quienes necesitan usar su documentación fuera de Costa Rica ofrecemos servicios
    posteriores a la inscripción: actas, certificados de estado civil, apostilla, traducción y envío
    internacional a cualquier parte del mundo. Así, las parejas extranjerxs pueden casarse, regresar a su
    país y recibir después los documentos que necesiten.`,
  },
];
---

<section class="mb-[200px] space-y-[100px]">
  <Container
    fullWidth={false}
    customClass="space-y-[-50px] md:space-y-[-55px] title-animation"
  >
    <SectionTitle
      title="Nuestro"
      customClass="col-start-1 col-span-4 md:hidden"
    />
    <SectionTitle
      title="Proceso"
      serif={true}
      customClass="col-start-2 col-span-1 text-right md:hidden"
    />
    <div class="md:col-start-1 md:col-span-8 md:flex gap-[10px] hidden">
      <SectionTitle title="Nuestro" customClass="" />
      <SectionTitle title="Proceso" serif={true} customClass=" md:text-left" />
    </div>
    <SectionTitle
      title="Se basa en"
      customClass="col-start-1 col-span-3 text-right md:col-start-3 md:col-span-5 md:leading-[80px]"
    />
  </Container>

  <Container customClass="overflow-hidden">
    {processes.map((item, i) => <ProcesoItem {...item} index={i} />)}
  </Container>
</section>
