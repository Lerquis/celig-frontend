---
import Container from "../atoms/Container.astro";
import SectionTitle from "../atoms/SectionTitle.astro";
import ProcesoItem from "../molecules/ProcesoItem.astro";
import { getLangFromUrl, useTranslations, type Locale } from "@/i18n";

interface Props {
  lang?: Locale;
}

const { lang: propLang } = Astro.props;
const lang = propLang || getLangFromUrl(Astro.url, Astro.request.headers.get("cookie"));
const t = useTranslations(lang);

const processes: { title: string; parragraph: string }[] = t("home.proceso.steps") || [];
---

<section class="mb-[200px] space-y-[100px]">
  <Container
    fullWidth={false}
    customClass="space-y-[-50px] md:space-y-[-55px] title-animation"
  >
    <SectionTitle
      title={t("home.proceso.title1")}
      customClass="col-start-1 col-span-4 md:hidden"
    />
    <SectionTitle
      title={t("home.proceso.title2")}
      serif={true}
      customClass="col-start-2 col-span-1 text-right md:hidden"
    />
    <div class="md:col-start-1 md:col-span-8 md:flex gap-[10px] hidden">
      <SectionTitle title={t("home.proceso.title1")} customClass="" />
      <SectionTitle title={t("home.proceso.title2")} serif={true} customClass=" md:text-left" />
    </div>
    <SectionTitle
      title={t("home.proceso.title3")}
      customClass="col-start-1 col-span-3 text-right md:col-start-3 md:col-span-5 md:leading-[80px]"
    />
  </Container>

  <Container customClass="overflow-hidden">
    {processes.map((item, i) => <ProcesoItem {...item} index={i} />)}
  </Container>
</section>
