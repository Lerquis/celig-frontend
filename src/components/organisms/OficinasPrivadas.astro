---
import Container from "../atoms/Container.astro";
import SectionTitle from "../atoms/SectionTitle.astro";
import Parragraph from "../atoms/Parragraph.astro";
---

<section class="mb-[200px] space-y-[100px]">
  <Container
    fullWidth={false}
    customClass="space-y-[-50px] md:space-y-[-80px] title-animation"
  >
    <SectionTitle
      title="Oficinas"
      customClass="col-start-1 col-span-4 md:col-span-8 text-center xl:col-span-12"
    />
    <SectionTitle
      title="Privadas"
      serif={true}
      customClass="col-start-1 col-span-4 md:col-span-8 text-center xl:col-span-12"
    />
  </Container>

  <Container fullWidth={false}>
    <Parragraph
      customClass="col-start-1 col-span-4 md:col-span-8 xl:col-span-12 text-animation text-center xl:w-[70%] xl:mx-auto"
      text={`CELIG te ofrece la posibilidad de celebrar tu matrimonio en oficinas privadas, elegantes
      y discretas. Cada matrimonio se atiende de forma personalizada, en un espacio pensado para que
      vivan ese momento con tranquilidad, comodidad y privacidad. Pueden optar por una boda civil
      íntima o compartir el momento con quienes deseen tener presentes. También coordinamos
      matrimonios en otros lugares de Costa Rica, según el servicio contratado.`}
    />
  </Container>
</section>
