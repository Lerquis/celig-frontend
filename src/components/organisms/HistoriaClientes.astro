---
import Container from "../atoms/Container.astro";
import SectionTitle from "../atoms/SectionTitle.astro";
import TestimonialItem from "../molecules/TestimonialItem.astro";
import ButtonPride from "../atoms/ButtonPride.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath, type Locale } from "@/i18n";

interface Props {
  lang?: Locale;
}

const { lang: propLang } = Astro.props;
const lang = propLang || getLangFromUrl(Astro.url, Astro.request.headers.get("cookie"));
const t = useTranslations(lang);

const rawTestimonialData = t("home.testimonios.items") || [];
const staticSources = [
  "/Testimonio1.jpeg",
  "/Testimonio2.jpg",
  "/Testimonio3.webp",
  "/Testimonio4.webp",
];

const testimonials = rawTestimonialData.map((item: any, i: number) => ({
  src: staticSources[i] || "/Testimonio1.jpeg",
  names: item.names,
  content: item.content,
}));
---

<section class="mb-[200px] space-y-[100px]">
  <Container
    fullWidth={false}
    customClass="space-y-[-50px] md:space-y-[-80px] title-animation"
  >
    <SectionTitle
      title={t("home.testimonios.title1")}
      customClass="col-start-1 col-span-4 md:col-span-8"
    />
    <SectionTitle
      title={t("home.testimonios.title2")}
      serif={true}
      customClass="col-start-2 col-span-3"
    />
    <SectionTitle
      title={t("home.testimonios.title3")}
      serif={true}
      customClass="col-start-1 col-span-4 md:col-start-3"
    />
  </Container>

  <Container customClass="space-y-[20px]">
    {testimonials.map((item: any, index: number) => <TestimonialItem {...item} {index} />)}
  </Container>

  <Container customClass="flex justify-center">
    <ButtonPride
      customClass="float-end w-[200px] hidden xl:flex xl:justify-center xl:col-start-11 xl:col-span-2 xl:h-fit xl:self-end xl:justify-self-end xl:translate-y-[-30px]"
    >
      <span class="relative z-10">
        <a href={getLocalizedPath("/testimonios", lang)} class="text-white no-underline">{t("home.testimonios.viewAll")}</a>
      </span>
    </ButtonPride>
  </Container>
</section>
