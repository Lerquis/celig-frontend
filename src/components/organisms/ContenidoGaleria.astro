---
import { galleryApi } from "@/api";
import Container from "../atoms/Container.astro";
import GaleriaMasonry from "../molecules/GaleriaMasonry";

const breakpointColumnsObj = {
  default: 4,
  1100: 3,
  700: 2,
  500: 1,
};
const IMAGES_PER_PAGE = 20;

let initialData = { images: [] };
const response = await galleryApi.getGallery({ page: 1, limit: IMAGES_PER_PAGE });
if (response.status === 200) initialData = response.body;
---

<Container customClass="content-container-galeria opacity-0" style="display: none;">
  <div class="col-start-1 col-span-4 md:col-span-8 xl:col-span-12 space-y-6">
    <GaleriaMasonry initialData={initialData} itemsPerPage={IMAGES_PER_PAGE} client:load />
  </div>
</Container>
