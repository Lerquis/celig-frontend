---
import { formatDateToDDMMYYYY } from "@/lib/dateFormatter";
import ButtonPride from "../atoms/ButtonPride.astro";
import Parragraph from "../atoms/Parragraph.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath, type Locale } from "@/i18n";
import { getTranslatedTag } from "@/lib/tagTranslations";

interface Props {
  title?: string;
  title_en?: string;
  tags: string[];
  updatedAt?: string;
  createdAt?: string;
  content?: string;
  content_en?: string;
  slug: string;
  lang?: Locale;
}

const {
  title,
  title_en,
  tags = [],
  updatedAt,
  createdAt,
  content,
  content_en,
  slug,
  lang: propLang,
} = Astro.props;

const lang = propLang || getLangFromUrl(Astro.url, Astro.request.headers.get("cookie"));
const t = useTranslations(lang);

const displayTitle = lang === "en" ? title_en || title || "" : title || "";

const displayContent = lang === "en" ? content_en || content || "" : content || "";

const date = updatedAt || createdAt || "";
const translatedTags = (tags || []).map((tag: string) => getTranslatedTag(tag, lang));
---

<div
  class="bg-white px-4 py-2 md:py-6 md:px-6 flex flex-col space-y-[20px] shadow-2xl rounded-sm"
>
  <div class="space-y-[5px]">
    <h3
      class="montreg text-[20px] xl:text-[24px] tracking-[1px] !leading-[25px]"
    >
      {displayTitle}
    </h3>
    <p class="text-[12px]">{translatedTags.join(", ")}</p>
  </div>
  <Parragraph text={displayContent} customClass="truncate-multiline" />
  <div class="flex justify-between items-end">
    <Parragraph text={formatDateToDDMMYYYY(date, false)} />
    <ButtonPride customClass="w-fit self-end">
      <span class="relative z-[5]">
        <a href={getLocalizedPath(`/blogs/${slug}`, lang)} class="text-white no-underline">
          {t("contenidoPage.readMore") || (lang === "en" ? "Read more" : "Leer más")}
        </a>
      </span>
    </ButtonPride>
  </div>
</div>
