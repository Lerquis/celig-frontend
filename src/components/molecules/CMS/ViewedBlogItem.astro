---
const { blog } = Astro.props;
const displayTitle = blog.title || "";
const tags = Array.isArray(blog.tags) ? blog.tags : [];
---

<div class="flex items-center justify-between gap-8">
  <div>
    <p class="font-medium">{displayTitle}</p>
    <p class="text-sm text-muted-foreground flex flex-wrap gap-2">
      {
        tags.map((tag: string) => (
          <span class="bg-black text-white py-[4px] px-[8px] text-[10px] rounded-full">
            {tag}
          </span>
        ))
      }
    </p>
  </div>
  <span class="text-xs text-muted-foreground">{blog.views ?? 0}</span>
</div>
