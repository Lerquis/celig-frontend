---
import Container from "../atoms/Container.astro";
import ContentNavBarButton from "../atoms/ContentNavBarButton.astro";
import { getLangFromUrl, useTranslations, type Locale } from "@/i18n";

interface Props {
  lang?: Locale;
}

const { lang: propLang } = Astro.props;
const lang = propLang || getLangFromUrl(Astro.url, Astro.request.headers.get("cookie"));
const t = useTranslations(lang);
---

<Container>
  <div
    class="col-start-1 col-span-4 md:col-span-8 xl:col-span-12 flex justify-between gap-2 flex-wrap"
  >
    <ContentNavBarButton text={t("contenidoPage.tabs.blogs")} container="blogs" />
    <ContentNavBarButton text={t("contenidoPage.tabs.galeria")} container="galeria" />
    <ContentNavBarButton text={t("contenidoPage.tabs.podcasts")} container="podcasts" />
  </div>
</Container>

<script>
  import gsap from "gsap";

  const blogButton = document.querySelector(".content-navbar-blogs");
  const galleryButton = document.querySelector(".content-navbar-galeria");
  const podcastsButton = document.querySelector(".content-navbar-podcasts");
  let isAnimating = false;

  // initial state to button
  blogButton?.classList.add("selectedNavBar");

  const changeSelectedButton = (e: any) => {
    const btn = e.currentTarget || e.target.closest("button");
    if (!btn || isAnimating) return;
    const currentSelectedButton = document.querySelector(".selectedNavBar");
    if (currentSelectedButton === btn) return;

    const containerName = btn.dataset.container || btn.getAttribute("data-container");
    const currentContainerName = currentSelectedButton?.getAttribute("data-container");

    const nextContainer = document.querySelector(`.${containerName}`);
    const currentContainer = document.querySelector(`.${currentContainerName}`);
    if (!nextContainer || !currentContainer) return;

    // cambiar los botones
    isAnimating = true;
    currentSelectedButton?.classList.remove("selectedNavBar");
    btn.classList.add("selectedNavBar");

    // creamos timeline para la animacion
    const tl = gsap.timeline();

    // movemos el contenedor actual
    tl.to(currentContainer, {
      x: -500,
      opacity: 0,
      duration: 0.4,
      ease: "power3.inOut",
      onComplete: () => {
        // el contenedor actual lo escondemos del dom para que no estorbe
        gsap.set(currentContainer, {
          display: "none",
        });
      },
      // seteamos y movemos el siguiente contenedor
    }).fromTo(
      nextContainer,
      {
        display: "grid",
        opacity: 0,
        x: 500,
      },
      {
        display: "grid",
        opacity: 1,
        x: 0,
        duration: 0.4,
        ease: "power3.inOut",
        onComplete: () => {
          isAnimating = false;
        },
      }
    );
  };

  blogButton?.addEventListener("click", changeSelectedButton);
  galleryButton?.addEventListener("click", changeSelectedButton);
  podcastsButton?.addEventListener("click", changeSelectedButton);
</script>
