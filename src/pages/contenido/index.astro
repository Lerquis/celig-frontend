---
export const prerender = false;

import Background from "@/components/atoms/General/Background.astro";
import GridOverlay from "@/components/atoms/General/GridOverlay.astro";
import ContenidoTemplate from "@/components/templates/ContenidoTemplate.astro";
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath } from "@/i18n";

const lang = getLangFromUrl(Astro.url, Astro.request.headers.get("cookie"));
const t = useTranslations(lang);

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: lang === "en" ? "LGBTIQ+ Multimedia Content - CELIG" : "Contenido Multimedia LGBTIQ+ - CELIG",
  description:
    lang === "en"
      ? "Blogs, podcasts, and photo gallery on LGBTIQ+ rights in Costa Rica. Educational content and legal resources."
      : "Blogs, podcasts y galería de imágenes sobre derechos LGBTIQ+ en Costa Rica. Contenido educativo y recursos legales.",
  url: "https://celigcr.com/contenido",
  isPartOf: {
    "@type": "WebSite",
    name: "CELIG - Centro Legal LGBTIQ+",
    url: "https://celigcr.com",
  },
  publisher: {
    "@type": "Organization",
    name: "CELIG - Centro Legal LGBTIQ+",
    logo: "https://celigcr.com/CroppedLogo.PNG",
  },
};
---

<Layout
  title={t("contenidoPage.seo.title")}
  description={t("contenidoPage.seo.description")}
  canonical={getLocalizedPath("/contenido", lang)}
  schema={pageSchema}
  lang={lang}
>
  <Background />
  <GridOverlay />

  <ContenidoTemplate lang={lang} />
</Layout>
