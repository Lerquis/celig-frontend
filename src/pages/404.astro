---
export const prerender = false;

import Background from "@/components/atoms/General/Background.astro";
import GridOverlay from "@/components/atoms/General/GridOverlay.astro";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/atoms/Container.astro";
import SectionTitle from "@/components/atoms/SectionTitle.astro";
import Parragraph from "@/components/atoms/Parragraph.astro";
import ButtonPride from "@/components/atoms/ButtonPride.astro";
import Footer from "@/components/organisms/Footer.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath } from "@/i18n";

// Astro renderiza automáticamente este archivo para cualquier ruta que no exista,
// y también es el destino de los Astro.redirect("/404") de las páginas dinámicas
// (ej. /blogs/[slug], /servicio/[slug]) cuando el slug no corresponde a nada real.
Astro.response.status = 404;

const lang = getLangFromUrl(Astro.url, Astro.request.headers.get("cookie"));
const t = useTranslations(lang);
---

<Layout
  title={t("notFoundPage.seo.title")}
  description={t("notFoundPage.seo.description")}
  noindex={true}
  lang={lang}
>
  <Background />
  <GridOverlay />

  <section class="pt-24 pb-0 min-h-[80vh] flex flex-col justify-center space-y-[30px] xl:space-y-[40px]">
    <Container>
      <p
        class="col-start-1 col-span-4 md:col-span-8 xl:col-span-12 text-center montreg tracking-[4px] text-[14px] opacity-50"
      >
        404
      </p>
    </Container>

    <Container customClass="space-y-[-50px] md:space-y-[-80px]">
      <SectionTitle
        title={t("notFoundPage.title1")}
        customClass="col-start-1 col-span-4 md:col-span-8 xl:col-span-12 text-center"
      />
      <SectionTitle
        title={t("notFoundPage.title2")}
        serif={true}
        customClass="col-start-1 col-span-4 md:col-span-8 xl:col-span-12 text-center"
      />
    </Container>

    <Container>
      <div
        class="col-start-1 col-span-4 md:col-span-8 xl:col-span-12 flex flex-col items-center space-y-[30px]"
      >
        <div class="customGradient h-[3px] w-[120px] rounded-full"></div>
        <Parragraph text={t("notFoundPage.message")} customClass="text-center max-w-[600px]" />

        <ButtonPride customClass="w-fit">
          <span class="relative z-[5]">
            <a href={getLocalizedPath("/", lang)} class="text-white no-underline">
              {t("notFoundPage.cta")}
            </a>
          </span>
        </ButtonPride>
      </div>
    </Container>
  </section>

  <Footer lang={lang} />
</Layout>
