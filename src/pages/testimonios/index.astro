---
export const prerender = false;

import Background from "@/components/atoms/General/Background.astro";
import GridOverlay from "@/components/atoms/General/GridOverlay.astro";
import TestimoniosTemplate from "@/components/templates/TestimoniosTemplate.astro";
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath } from "@/i18n";

const lang = getLangFromUrl(Astro.url, Astro.request.headers.get("cookie"));
const t = useTranslations(lang);

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: lang === "en" ? "Testimonials - CELIG" : "Testimonios - CELIG",
  description:
    lang === "en"
      ? "Read authentic client testimonials on CELIG's LGBTIQ+ legal services in Costa Rica. Marriage equality, consultations, and rights defense."
      : "Lee las experiencias reales de nuestros clientes con los servicios legales LGBTIQ+ de CELIG. Historias de matrimonios igualitarios, consultas legales y defensa de derechos.",
  url: "https://celigcr.com/testimonios",
  isPartOf: {
    "@type": "WebSite",
    name: "CELIG - Centro Legal LGBTIQ+",
    url: "https://celigcr.com",
  },
  publisher: {
    "@type": "Organization",
    name: "CELIG - Centro Legal LGBTIQ+",
    logo: "https://celigcr.com/CroppedLogo.PNG",
  },
};
---

<Layout
  title={t("testimoniosPage.seo.title")}
  description={t("testimoniosPage.seo.description")}
  canonical={getLocalizedPath("/testimonios", lang)}
  schema={pageSchema}
  lang={lang}
>
  <Background />
  <GridOverlay />

  <TestimoniosTemplate lang={lang} />
</Layout>
