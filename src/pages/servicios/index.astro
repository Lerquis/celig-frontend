---
export const prerender = false;

import { getLangFromUrl, getLocalizedPath } from "@/i18n";

const lang = getLangFromUrl(Astro.url, Astro.request.headers.get("cookie"));
const target = getLocalizedPath("/#servicios", lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <title>{lang === "en" ? "Services" : "Servicios"}</title>
    <!-- Redirección inmediata (fallback compatible) -->
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <script define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </body>
</html>
